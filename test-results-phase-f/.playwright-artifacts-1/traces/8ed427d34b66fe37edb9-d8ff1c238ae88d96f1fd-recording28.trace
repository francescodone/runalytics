ound: var(--desk-glass);\n      -webkit-backdrop-filter: blur(20px) saturate(135%);\n      backdrop-filter: blur(20px) saturate(135%);\n      border-color: var(--desk-glass-border);\n      box-shadow: inset 0 1px 0 var(--desk-highlight), 0 6px 24px #00000009;\n   }\n   .health-verdict, .health-analysis, .health-history { background: color-mix(in srgb, var(--desk-surface) 48%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }\n   .session-tile { background: color-mix(in srgb, var(--desk-surface) 72%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }\n   .session-tile.selected { background: var(--desk-selection); }\n   .desk-button:not(.primary) { background-color: color-mix(in srgb, var(--desk-surface) 90%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }\n   .desk-notice { background: color-mix(in srgb, var(--desk-ink) 92%, transparent); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }\n   .desk-dialog::backdrop { background: #0b171b40; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }\n  @media (max-width: 800px) {\n      .desk-navigation { background: var(--desk-glass); -webkit-backdrop-filter: blur(20px) saturate(135%); backdrop-filter: blur(20px) saturate(135%); }\n      .desk-dialog, .desk-inspector { background: color-mix(in srgb, var(--desk-surface) 88%, transparent); }\n  }\n}\n@media (prefers-reduced-transparency: reduce), (prefers-contrast: more), (forced-colors: active) {\n  :root { --desk-glass: var(--desk-surface); }\n  .desk-appbar::before { display: none; }\n   .desk-appbar, .desk-toolbar, .desk-dialog, .desk-inspector, .journal-workspace .desk-inspector, .desk-navigation, .route-controls, .health-verdict, .health-analysis, .health-history, .session-tile, .desk-button:not(.primary) { background: var(--desk-surface); -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; }\n   .session-tile.selected { backgr