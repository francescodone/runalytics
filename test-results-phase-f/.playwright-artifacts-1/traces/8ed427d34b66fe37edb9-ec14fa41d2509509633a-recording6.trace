{"version":10,"type":"context-options","origin":"library","browserName":"chromium","playwrightVersion":"1.64.1","options":{"noDefaultViewport":false,"viewport":{"width":390,"height":844},"ignoreHTTPSErrors":false,"javaScriptEnabled":true,"bypassCSP":false,"locale":"en-US","offline":false,"isMobile":false,"hasTouch":false,"colorScheme":"light","reducedMotion":"reduce","forcedColors":"none","acceptDownloads":"accept","contrast":"no-preference","baseURL":"http://127.0.0.1:1500","serviceWorkers":"allow","selectorEngines":[],"testIdAttributeName":"data-testid"},"platform":"darwin","wallTime":1793550313322,"monotonicTime":16294.429,"sdkLanguage":"javascript","testIdAttributeName":"data-testid","channel":"chrome","title":"desk.spec.mjs:111 › motion system › semantic reveals and compact presses no-preference 1440px"}
