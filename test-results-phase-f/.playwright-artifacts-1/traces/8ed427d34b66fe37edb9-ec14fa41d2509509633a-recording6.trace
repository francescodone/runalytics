{"type":"before","callId":"awic@564","startTime":16403.087,"class":"Page","method":"addInitScript","params":{"source":"(function () {\n  /* Shared `activity_review` stub for the harnesses.\n\n   Both the dashboard harness and the calendar harness open a recorded run,\n   and both must draw the same review — otherwise a fix verified on one page\n   can still be broken on the other. The layout below is what the backend's\n   `laps::build` returns for a \"4 x 1 km tempo\" prescription: an open-ended\n   warm-up, four graded reps with ungraded recoveries between them, and an\n   open-ended cool-down.\n\n   The paces are chosen to cover every verdict the chart can render, because\n   each one has its own styling and an untested one is an unstyled one:\n   rep 1 too fast, rep 2 in range, rep 3 too slow, rep 4 in range. The warm-up,\n   cool-down, and recoveries carry no band at all — only the work is graded,\n   and a target that was never set must not be drawn as one. */\n(function () {\n  // `frac` is the lap's share of the run, so the laps always sum to whatever\n  // distance the activity claims and the tiles above the chart agree with\n  // the bars below them.\n  const LAYOUT = [\n    { kind: \"easy\", label: \"Warm-up - easy jog\", frac: 0.24, pace: 372, hr: 138 },\n    { kind: \"work\", label: \"Fast repetitions - jog between reps only\", frac: 0.12, pace: 268, hr: 172, bandLo: 275, bandHi: 285 },\n    { kind: \"recovery\", label: \"Recovery\", frac: 0.025, pace: 340, hr: 160 },\n    { kind: \"work\", label: \"Fast repetitions - jog between reps only\", frac: 0.12, pace: 279, hr: 176, bandLo: 275, bandHi: 285 },\n    { kind: \"recovery\", label: \"Recovery\", frac: 0.025, pace: 348, hr: 162 },\n    { kind: \"work\", label: \"Fast repetitions - jog between reps only\", frac: 0.12, pace: 291, hr: 178, bandLo: 275, bandHi: 285 },\n    { kind: \"recovery\", label: \"Recovery\", frac: 0.025, pace: 355, hr: 165 },\n    { kind: \"work\", label: \"Fast repetitions - jog between reps only\", frac: 0.12, pace: 281, hr: 179, bandLo: 275, bandHi: 285 },\n    { kind: \"easy\", label: \"Cool-down - easy jog\", frac: 0.205, pace: 402, hr: 134 },\n  ];\n\n  // Mirrors `laps::grade`, tolerance included, so the harness cannot show a\n  // bar whose colour disagrees with the range drawn over it. No band — no\n  // verdict: the easy and recovery laps are never graded.\n  function verdictFor(seg, tolerance) {\n    if (seg.bandLo == null || seg.bandHi == null) return null;\n    if (seg.pace < seg.bandLo - tolerance) return \"ahead\";\n    if (seg.pace > seg.bandHi + tolerance) return \"behind\";\n    return \"in\";\n  }\n\n  /// An open route along the Isar with some wiggle, so the route map, its\n  /// start/finish dots and its controls all render.\n  /// Barometric altitude over the run's progress (0..1): rolling hills with a\n  /// net climb, so the splits' elevation column shows gains, near-flat\n  /// kilometres, and descents reading as a small gain rather than zero.\n  function altAt(t) {\n    return 520 + Math.sin(t * Math.PI * 2) * 40 + t * 10;\n  }\n\n  /// Metres climbed between two fractions of the run, sampled the same way\n  /// the backend sums positive altitude steps per kilometre.\n  function elevationGain(fromT, toT) {\n    const steps = 24;\n    let gain = 0;\n    let prev = altAt(fromT);\n    for (let i = 1; i <= steps; i++) {\n      const alt = altAt(fromT + ((toT - fromT) * i) / steps);\n      gain += Math.max(0, alt - prev);\n      prev = alt;\n    }\n    return Math.round(gain);\n  }\n\n  function trackFor(activity) {\n    const base = Math.floor(Date.parse(activity.startTime) / 1000);\n    const track = [];\n    for (let i = 0; i <= 80; i++) {\n      const t = i / 80;\n      track.push({\n        ts: base + i * 30,\n        lat: 48.1345 + t * 0.038 + Math.sin(t * 9) * 0.0016,\n        lon: 11.5768 + t * 0.014 + Math.sin(t * 7) * 0.0022,\n        hr: 140 + Math.round(20 * Math.sin(t * 4)),\n        alt: Math.round(altAt(t) * 10) / 10,\n      });\n    }\n    return track;\n  }\n\n  /// The activity as the review's headline needs it: duration and average pace\n  /// derived from the laps themselves. A tile reading 5:50/km above a chart of\n  /// 4:28-4:51 reps would look like a rendering bug rather than a stub, and the\n  /// whole point of the chart is that the two agree.\n  function summarised(activity, laps) {\n    const durationS = laps.reduce((sum, l) => sum + l.durationS, 0);\n    const distanceM = laps.reduce((sum, l) => sum + l.meters, 0);\n    return {\n      ...activity,\n      durationS,\n      distanceM,\n      avgPaceSKm: distanceM > 0 ? Math.round((durationS / distanceM) * 1000) : null,\n      hasTrack: true,\n    };\n  }\n\n  window.__reviewFor = function (activity, workoutId, tolerance) {\n    const tol = tolerance ?? 4;\n    const total = activity.distanceM;\n    let startM = 0;\n    const laps = LAYOUT.map((seg, i) => {\n      const meters = Math.round(seg.frac * total);\n      const lap = {\n        index: i + 1,\n        label: seg.label,\n        kind: seg.kind,\n        startM,\n        meters,\n        durationS: Math.round((meters / 1000) * seg.pace),\n        avgPaceSKm: seg.pace,\n        avgHr: seg.hr,\n        bandLoSKm: seg.bandLo ?? null,\n        bandHiSKm: seg.bandHi ?? null,\n        verdict: verdictFor(seg, tol),\n      };\n      startM += meters;\n      return lap;\n    });\n\n    // Kilometre splits, cut by distance rather than by the plan, walked over\n    // the same laps so the table and the chart can never tell two stories.\n    // The last window is a part-kilometre, exactly like the backend's.\n    const splits = [];\n    const runMeters = laps.reduce((sum, lap) => sum + lap.meters, 0);\n    let pi = 0;\n    let piUsed = 0;\n    let kmMetres = 0;\n    let kmDur = 0;\n    let kmHr = 0;\n    let kmFrom = 0;\n    let prev = null;\n    while (pi < laps.length || kmMetres > 0) {\n      if (pi < laps.length) {\n        const lap = laps[pi];\n        const seg = LAYOUT[pi];\n        const take = Math.min(lap.meters - piUsed, 1000 - kmMetres);\n        kmDur += (take / 1000) * seg.pace;\n        // Metre-weighted, not lap-weighted: a kilometre that spans a rep and a\n        // recovery averages the two rates by how much of each it contains.\n        kmHr += take * seg.hr;\n        kmMetres += take;\n        piUsed += take;\n        if (piUsed >= lap.meters) {\n          pi++;\n          piUsed = 0;\n        }\n      }\n      if (kmMetres >= 1000 || (pi >= laps.length && kmMetres > 0)) {\n        const avg = kmDur / (kmMetres / 1000);\n        const seg = LAYOUT[Math.min(pi, laps.length - 1)];\n        splits.push({\n          km: splits.length + 1,\n          meters: kmMetres,\n          durationS: Math.round(kmDur),\n          avgPaceSKm: Math.round(avg),\n          avgHr: Math.round(kmHr / kmMetres),\n          elevationGainM: elevationGain(kmFrom / runMeters, (kmFrom + kmMetres) / runMeters),\n          deltaPrevSKm: prev == null ? null : Math.round(avg - prev),\n          bandLoSKm: seg.bandLo ?? null,\n          bandHiSKm: seg.bandHi ?? null,\n        });\n        kmFrom += kmMetres;\n        prev = avg;\n        kmMetres = 0;\n        kmDur = 0;\n        kmHr = 0;\n      }\n    }\n\n    return {\n      activity: summarised(activity, laps),\n      hasTrack: true,\n      track: trackFor(activity),\n      workoutId: workoutId ?? null,\n      prescribed: true,\n      laps,\n      splits,\n    };\n  };\n\n  /// The fallback the backend uses when no session was planned for a run: the\n  /// kilometres become the laps, with no target caps anywhere. Worth having in\n  /// the harness because the chart's legend and the empty band both read\n  /// differently here, and it is the state most runs on the dashboard are in.\n  window.__kmReviewFor = function (activity) {\n    const track = trackFor(activity);\n    const splits = [];\n    const total = activity.distanceM;\n    const n = Math.ceil(total / 1000);\n    let prev = null;\n    for (let i = 0; i < n; i++) {\n      const meters = Math.min(1000, total - i * 1000);\n      // A gentle negative split across the run, so the delta column shows both\n      // signs rather than a wall of one colour.\n      const pace = (activity.avgPaceSKm ?? 340) + 12 - (i / Math.max(1, n - 1)) * 24;\n      splits.push({\n        km: i + 1,\n        meters,\n        durationS: Math.round((meters / 1000) * pace),\n        avgPaceSKm: Math.round(pace),\n        avgHr: activity.avgHr == null ? null : activity.avgHr + 6 - i,\n        elevationGainM: elevationGain((i * 1000) / total, (i * 1000 + meters) / total),\n        deltaPrevSKm: prev == null ? null : Math.round(pace - prev),\n        bandLoSKm: null,\n        bandHiSKm: null,\n        openEnded: false,\n      });\n      prev = pace;\n    }\n    const laps = splits.map((s) => ({\n      index: s.km,\n      label: `${s.km} km`,\n      kind: \"kilometre\",\n      startM: (s.km - 1) * 1000,\n      meters: s.meters,\n      durationS: s.durationS,\n      avgPaceSKm: s.avgPaceSKm,\n      avgHr: s.avgHr,\n      bandLoSKm: null,\n      bandHiSKm: null,\n      openEnded: false,\n      verdict: null,\n    }));\n    return {\n      activity: summarised(activity, laps),\n      hasTrack: true,\n      track,\n      workoutId: null,\n      prescribed: false,\n      laps,\n      splits,\n    };\n  };\n})();\n\n  \n      // ?tour=1 clears the tutorial flag so the onboarding slides can be\n      // walked through in the harness.\n      if (new URLSearchParams(location.search).has(\"tour\"))\n        localStorage.removeItem(\"runalytics.onboarding.v2\");\n      else localStorage.setItem(\"runalytics.onboarding.v2\", \"done\");\n      const day = (n) => new Date(Date.now() - n * 864e5).toISOString();\n      // ?offset=-5 gives the plan an accepted pacing adjustment, to check the\n      // week plan shows the shifted tempo range rather than the stored one. The\n      // offset takes effect from Monday so the week's tempo session falls under\n      // it, exactly as a session run after accepting an adjustment would.\n      const harnessOffset = Number(new URLSearchParams(location.search).get(\"offset\") ?? 0);\n      const ymdOf = (d) =>\n        `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(\n          d.getDate(),\n        ).padStart(2, \"0\")}`;\n      const mondayThisWeek = () => {\n        const d = new Date();\n        d.setDate(d.getDate() - ((d.getDay() + 6) % 7));\n        return ymdOf(d);\n      };\n      // A whole plan's sessions, past and future, so the dashboard's plan\n      // timeline has a ramp to draw: 8 weeks running from 3 weeks ago to a\n      // race 49 days out, volume climbing then tapering, 4 runs a week.\n      const planWorkouts = () => {\n        const out = [];\n        const base = new Date();\n        base.setDate(base.getDate() - ((base.getDay() + 6) % 7) - 21);\n        for (let w = 0; w < 8; w++) {\n          const taper = w >= 6 ? [0.85, 0.6][w - 6] : 1;\n          const long = Math.round((14 + w * 1.6) * taper);\n          const spec = [\n            [\"easy\", \"Easy 6 km\", 6],\n            [\"tempo\", \"Tempo 5 km\", 5],\n            [\"easy\", \"Recovery 5 km\", 5],\n            [\"longRun\", `Long ${long} km`, long],\n          ];\n          spec.forEach(([kind, title, km], i) => {\n            const d = new Date(base);\n            d.setDate(base.getDate() + w * 7 + [0, 2, 4, 6][i]);\n            out.push({\n              id: `pw-${w}-${i}`,\n              planId: \"p1\",\n              date: ymdOf(d),\n              kind,\n              title,\n              distanceM: km * 1000,\n              durationMin: Math.round(km * 5.4),\n              paceLoSKm: kind === \"easy\" ? 360 : 300,\n              paceHiSKm: kind === \"easy\" ? 400 : 330,\n              done: d < new Date(),\n            });\n          });\n        }\n        const race = new Date();\n        race.setDate(race.getDate() + 48);\n        out.push({\n          id: \"pw-race\",\n          planId: \"p1\",\n          date: ymdOf(race),\n          kind: \"race\",\n          title: \"Race day\",\n          distanceM: 21097,\n          durationMin: null,\n          paceLoSKm: null,\n          paceHiSKm: null,\n          done: false,\n        });\n        return out;\n      };\n      // Per-day readiness sub-scores, oldest→newest — mirrors the backend's\n      // score_history: the last point's values are the headline scores.\n      const scoreHistory = Array.from({ length: 7 }, (_, i) => {\n        const n = 6 - i;\n        return {\n          date: day(n),\n          training: 60 + ((n * 17) % 30),\n          recovery: 45 + ((n * 11) % 40),\n          risk: 20 + ((n * 7) % 45),\n        };\n      });\n      scoreHistory[scoreHistory.length - 1] = {\n        date: day(0),\n        training: 78,\n        recovery: 61,\n        risk: 34,\n      };\n      const health = (n) => ({\n        date: day(n),\n        steps: 8000 + ((n * 971) % 4000),\n        avgHr: 62 + ((n * 7) % 9),\n        restingHr: 54 + ((n * 5) % 8),\n        stressAvg: 28 + ((n * 11) % 22),\n        sleepScore: 62 + ((n * 13) % 30),\n        sleepMin: 380 + ((n * 17) % 90),\n        deepMin: 60 + ((n * 9) % 40),\n        remMin: 80 + ((n * 6) % 40),\n        hrvAvg: 40 + ((n * 12) % 26),\n      });\n      // A run today (offset 0) so the week strip has actuals for the day the\n      // dashboard is being viewed on; the rest sit in earlier weeks.\n      const activities = [0, 1, 2, 4, 5, 8].map((n, i) => ({\n        id: i + 1,\n        provider: \"coros\",\n        providerRecordId: \"x\" + i,\n        sport: \"Run\",\n        startTime: day(n),\n        durationS: 2400 + i * 600,\n        distanceM: 8200 + i * 1500,\n        avgHr: 148 + i * 3,\n        maxHr: 170 + i * 2,\n        avgPaceSKm: 320 + i * 8,\n        elevationGainM: 60 + i * 20,\n        hasTrack: true,\n      }));\n      // Cross-training, deliberately placed to exercise both charts: a long\n      // spin TODAY (a double day — the week strip must mark it and keep it out\n      // of the kilometres), one ride last week, and a gym session whose\n      // distance is zero — the case that would print \"0 km of strength work\".\n      const cross = [\n        {\n          id: 90,\n          provider: \"coros\",\n          providerRecordId: \"ride-0\",\n          sport: \"Ride\",\n          startTime: day(0),\n          durationS: 9000,\n          distanceM: 90000,\n          avgHr: 132,\n          maxHr: 158,\n          avgPaceSKm: 100,\n          elevationGainM: 340,\n          hasTrack: true,\n        },\n        {\n          id: 91,\n          provider: \"coros\",\n          providerRecordId: \"ride-9\",\n          sport: \"Ride\",\n          startTime: day(9),\n          durationS: 7200,\n          distanceM: 62000,\n          avgHr: 128,\n          maxHr: 151,\n          avgPaceSKm: 116,\n          elevationGainM: 210,\n          hasTrack: true,\n        },\n        {\n          id: 92,\n          provider: \"coros\",\n          providerRecordId: \"gym-5\",\n          sport: \"Strength\",\n          startTime: day(5),\n          durationS: 2700,\n          distanceM: 0,\n          avgHr: 108,\n          maxHr: 142,\n          avgPaceSKm: null,\n          elevationGainM: null,\n          hasTrack: false,\n        },\n      ];\n      const painMode = new URLSearchParams(location.search).get(\"pain\") === \"1\";\n      const painEntry = {\n        id: \"FAKE-PAIN-ENTRY\", bodyPart: \"knee.right\", intensity: 6,\n        startedOn: day(2).slice(0, 10), notes: \"\", createdAt: day(2),\n        resolvedOn: null, followupAt: null,\n      };\n      const dashboard = {\n        scores: { trainingScore: 78, injuryRisk: painMode ? 65 : 34, recoveryScore: 61, globalScore: painMode ? 45 : 68, notes: [] },\n        scoreHistory,\n        fitness: {\n          date: day(0), vo2max: 54.2, thresholdSecKm: 278,\n          predict5kS: 1210, predict10kS: 2560, predictHalfS: 5600, predictMarathonS: 12100,\n        },\n        load: { date: day(0), shortTerm: 62, longTerm: 55, ratio: 1.13, comment: \"\" },\n        // Daily acute:chronic load, oldest→newest — a build that tips over the\n        // performance boundary, which is the interesting shape to look at.\n        loadHistory: [27, 26, 25, 24, 23, 22, 21, 20, 19, 18, 17, 16, 15, 14].map((n, i, a) => {\n          const shortTerm = [38, 41, 44, 42, 47, 51, 49, 54, 58, 56, 60, 63, 61, 62][i];\n          const longTerm = [52, 52, 53, 52, 53, 54, 53, 54, 55, 54, 55, 55, 55, 55][i];\n          return {\n            date: day(n),\n            shortTerm,\n            longTerm,\n            ratio: +(shortTerm / longTerm).toFixed(2),\n            comment: \"\",\n          };\n        }),\n        trainingStatus: { state: \"optimized\", label: \"Optimized\", reason: \"Recent load is 1.13× your recent average — the productive zone where base fitness is increasing.\", tone: \"good\", ratio: 1.13 },\n        // The boundaries the chart draws its bands from — normally the backend's\n        // normalised Thresholds, so the harness carries the COROS defaults.\n        thresholds: { ratioDecreasingHi: 0.5, ratioResumingHi: 0.8, ratioMaintainingHi: 1.0, ratioOptimizedHi: 1.5, recoveryExhausted: 19, recoveryFatigued: 69, recoveryNormal: 89, buildWeeks: 3, downWeekFactor: 0.7, paceToleranceSecKm: 4, paceStreak: 3 },\n        recoveryBand: { state: \"fatigued\", label: \"Fatigued\", tone: \"warn\", min: 20, max: 69 },\n        loadRecommendation: { target: 55, downWeek: false, weekInCycle: 2, cycleLength: 4, note: \"\" },\n        activities,\n        range: \"7d\",\n        stats: { distanceM: 52300, durationS: 14400, sessions: 5, avgPaceSKm: 332, avgHr: 151 },\n        health: [0, 1, 2, 3, 4, 5, 6].map(health),\n        // Mixed on purpose: the backend reports per-factor severity, so a\n        // healthy signal legitimately lands at 0 and the row has to say so.\n        riskFactors: [\n          { label: \"Load ratio (ACWR)\", detail: \"1.13 — within optimized range\", contribution: 0 },\n          { label: \"Volume spike\", detail: \"within baseline (106%)\", contribution: 0 },\n          { label: \"Sleep quality\", detail: \"78/100 avg\", contribution: 0 },\n          { label: \"HRV trend\", detail: \"41 ms vs 52 ms baseline\", contribution: 0.46 },\n          { label: \"Resting HR drift\", detail: \"52 bpm vs 50 bpm baseline\", contribution: 0 },\n          { label: \"Recovery debt\", detail: \"71/100 recovery from sleep, HRV and resting HR\", contribution: 0 },\n          ...(painMode ? [{ label: \"Reported pain\", detail: \"right knee 6/10\", contribution: 0.6 }] : []),\n        ],\n        activePain: painMode ? painEntry : null,\n        pendingProposal: null,\n      };\n      if (painMode) scoreHistory[scoreHistory.length - 1].risk = 65;\n      window.__TAURI_INTERNALS__ = {\n        invoke: async (cmd, args) => {\n          if (cmd === \"provider_status\") return [{ provider: \"coros\", connected: true, lastSync: day(0), detail: \"\" }];\n          if (cmd === \"current_plan\") return [\n            { id: \"p1\", distance: \"21K\", kind: \"race\", targetDate: day(-48), status: \"pushed\", weeklyFrequency: 4, longrunDay: 6, increase: \"moderate\", thresholdSecKm: 280, createdAt: day(10), pushedId: \"z\", baselineWeeklyKm: 32, qualityOffsetSecKm: harnessOffset, qualityOffsetFrom: harnessOffset === 0 ? null : mondayThisWeek() },\n            planWorkouts(),\n          ];\n          if (cmd === \"dashboard\") return dashboard;\n          if (cmd === \"activity_detail\") {\n            const a = activities.find((x) => x.id === args.activityId) ?? activities[0];\n            // An open route along the Isar with some wiggle, so the sheet's\n            // route map, its start/finish dots and its controls all render.\n            const base = Math.floor(Date.parse(a.startTime) / 1000);\n            const track = [];\n            for (let i = 0; i <= 80; i++) {\n              const t = i / 80;\n              track.push({\n                ts: base + i * 30,\n                lat: 48.1345 + t * 0.038 + Math.sin(t * 9) * 0.0016,\n                lon: 11.5768 + t * 0.014 + Math.sin(t * 7) * 0.0022,\n                hr: 140 + Math.round(20 * Math.sin(t * 4)),\n              });\n            }\n            return {\n              activity: a,\n              track,\n              health: health(1),\n              load: dashboard.load,\n              fitness: dashboard.fitness,\n              riskFactors: dashboard.riskFactors,\n              injuryRisk: 34,\n            };\n          }\n          if (cmd === \"activity_review\") {\n            const a = activities.find((x) => x.id === args.activityId) ?? activities[0];\n            // One run in the list is the tempo session, so the sheet shows the\n            // prescribed layout with its target caps; the rest are plain easy\n            // days, which the backend returns as per-kilometre laps with no\n            // caps at all. Both shapes have to look right.\n            return a.id === 1\n              ? window.__reviewFor(a, \"w2\", dashboard.thresholds.paceToleranceSecKm)\n              : window.__kmReviewFor(a);\n          }\n          // The dashboard's own `activities` stays runs-only, but all_activities\n          // carries every sport — that is the pair the mileage split is tested on.\n          if (cmd === \"all_activities\") return [...activities, ...cross];\n          if (cmd === \"pain_entries\") return painMode ? [painEntry] : [];\n          // This week is a recovery week: the badge on the \"This week\" panel\n          // and the dip in the mileage chart are the same fact, so the harness\n          // has to show them together.\n          if (cmd === \"down_weeks\") {\n            const d = new Date();\n            d.setDate(d.getDate() - ((d.getDay() + 6) % 7));\n            const m = String(d.getMonth() + 1).padStart(2, \"0\");\n            const dd = String(d.getDate()).padStart(2, \"0\");\n            return [`${d.getFullYear()}-${m}-${dd}`];\n          }\n          if (cmd === \"workouts_between\") {\n            // A plausible week: easy Mon, tempo Wed, easy Fri, long Sun —\n            // keyed by local YYYY-MM-DD like the backend's plan_workouts.\n            const ymd = (offset) => {\n              const d = new Date();\n              const dow = (d.getDay() + 6) % 7;\n              d.setDate(d.getDate() - dow + offset);\n              const m = String(d.getMonth() + 1).padStart(2, \"0\");\n              const dd = String(d.getDate()).padStart(2, \"0\");\n              return `${d.getFullYear()}-${m}-${dd}`;\n            };\n            return [\n              { id: \"w1\", planId: \"p1\", date: ymd(0), plannedDate: ymd(0), status: \"planned\", movedAt: null, kind: \"easy\", title: \"Easy 6 km\", distanceM: 6000, durationMin: 35, paceLoSKm: 360, paceHiSKm: 400, done: false },\n              { id: \"w2\", planId: \"p1\", date: ymd(2), plannedDate: ymd(2), status: \"planned\", movedAt: null, kind: \"tempo\", title: \"Tempo 5 km\", distanceM: 5000, durationMin: 30, paceLoSKm: 300, paceHiSKm: 330, done: true },\n              { id: \"w3\", planId: \"p1\", date: ymd(4), plannedDate: ymd(2), status: \"planned\", movedAt: \"2026-10-01T09:00:00Z\", kind: \"easy\", title: \"Easy 5 km\", distanceM: 5000, durationMin: 30, paceLoSKm: 360, paceHiSKm: 400, done: false },\n              { id: \"w4\", planId: \"p1\", date: ymd(6), plannedDate: ymd(6), status: \"planned\", movedAt: null, kind: \"longRun\", title: \"Long 14 km\", distanceM: 14000, durationMin: 80, paceLoSKm: 370, paceHiSKm: 420, done: false },\n              // A session the runner chose to skip: it must show in the\n              // adherence sentence as a decision, not as a miss.\n              { id: \"w5\", planId: \"p1\", date: ymd(1), plannedDate: ymd(1), status: \"skipped\", movedAt: null, kind: \"easy\", title: \"Easy 5 km\", distanceM: 5000, durationMin: 30, paceLoSKm: 360, paceHiSKm: 400, done: false },\n            ];\n          }\n          if (cmd === \"heat_points\") {\n            // A run cluster around Munich (English Garden / Isar) so the map\n            // and its controls render in the harness.\n            const pts = [];\n            for (let i = 0; i < 60; i++) {\n              pts.push({\n                lat: 48.1542 + Math.sin(i * 0.7) * 0.021 + (i % 5) * 0.0015,\n                lon: 11.582 + Math.cos(i * 0.5) * 0.026 + (i % 7) * 0.0012,\n                weight: ((i * 37) % 10) / 9,\n              });\n            }\n            return pts;\n          }\n          if (cmd === \"get_settings\") return { pmtilesPath: null, lastProvider: \"coros\", theme: \"system\", llmEnabled: false, llmEndpoint: null, llmModel: null, thresholds: dashboard.thresholds };\n          if (cmd === \"sync_status\") return false;\n          // Pacing: two sessions that landed too fast, one short of the streak\n          // of three — enough to prove the range bars and the \"one more\" line.\n          if (cmd === \"pacing_report\")\n            return {\n              needed: 3,\n              triggered: false,\n              streak: 2,\n              direction: \"ahead\",\n              reviews: [\n                { workoutId: \"w2\", date: day(-14), kind: \"tempo\", title: \"Tempo 5 km\", bandLoSKm: 275, bandHiSKm: 285, actualSKm: 268, measuredM: 1200, execution: \"ahead\" },\n                { workoutId: \"w2\", date: day(-7), kind: \"intervals\", title: \"6 x 800 m intervals\", bandLoSKm: 250, bandHiSKm: 260, actualSKm: 244, measuredM: 2400, execution: \"ahead\" },\n                { workoutId: \"w2\", date: day(-2), kind: \"tempo\", title: \"Tempo 6 km\", bandLoSKm: 275, bandHiSKm: 285, actualSKm: 279, measuredM: 1500, execution: \"in\" },\n              ],\n            };\n          if (cmd === \"pending_pacing_proposal\") return null;\n          throw new Error(\"unstubbed \" + cmd + \" \" + JSON.stringify(args));\n        },\n      };\n    \n  const deskOriginal = window.__TAURI_INTERNALS__.invoke;\n  let deskCurrent;\n  let deskSettings;\n  let deskPain = [];\n  let deskMessages = [];\n  let deskPublishing = {enabled:false, uploadUrl:'https://example.test/calendar.ics', subscriptionUrl:'https://example.test/calendar.ics', username:'synthetic', hasPassword:true, lastPublished:'2026-10-29T12:00:00Z', lastError:null};\n  let deskSync = {config:{enabled:true,gistId:'synthetic-gist',hasToken:true,canPublish:false,lastPushed:'2026-10-29T12:00:00Z',lastPulled:null,installedRev:7,lastError:null},accountLinked:true,code:'synthetic-account-channel'};\n  let deskKey = true;\n  let deskConnected = true;\n  const callbacks = new Map();\n  const listeners = new Map();\n  let callbackId = 0;\n  // The first three done plan sessions stand in for matched runs: the same\n  // pairing the backend derives from calendar_completions, so the journal can\n  // name a matched run after its session and the review can show its plan.\n  const deskMatched = async () => { const pair = await window.__TAURI_INTERNALS__.invoke('current_plan'); return (pair?.[1] ?? []).filter(workout => workout.done).slice(0, 3); };\n  window.__TAURI_INTERNALS__.transformCallback = callback => { callbacks.set(++callbackId, callback); return callbackId; };\n  window.__TAURI_INTERNALS__.unregisterCallback = identifier => callbacks.delete(identifier);\n  window.__TAURI_EVENT_PLUGIN_INTERNALS__ = {unregisterListener: () => {}};\n  window.__deskEmit = (event, payload) => { const listener = listeners.get(event); callbacks.get(listener)?.({event,id:listener,payload}); };\n  let proposal = new URLSearchParams(location.search).has('proposal') ? {id:'synthetic-proposal',source:'pain',status:'pending',summary:'Reduce the next quality session',reason:'Synthetic recovery adjustment',createdAt:'2026-10-30',edits:[{workoutId:'synthetic-workout',date:'2026-11-01',oldTitle:'Intervals',oldDistanceM:8000,title:'Easy run',distanceM:4000,kind:'easy'}]} : null;\n  if (new URLSearchParams(location.search).has('pacingProposal')) proposal = {id:'synthetic-pacing',source:'pacing',status:'pending',summary:'Sharpen quality pace by 5 s/km and review future session distances',reason:'Three completed quality sessions consistently faster than their own targets; recovery and load support progression.',createdAt:'2026-10-31',planQualityOffsetSecKm:-5,planQualityOffsetFrom:'2026-11-01',edits:[{workoutId:'synthetic-workout',date:'2026-11-02',oldTitle:'Tempo',oldDistanceM:10000,title:'Tempo',distanceM:10300,kind:'tempo',paceLoSKm:275,paceHiSKm:285}]};\n  window.__deskCalls = [];\n  window.__deskFail = '';\n  window.__TAURI_INTERNALS__.invoke = async (cmd, args = {}) => {\n    window.__deskCalls.push({command:cmd, args});\n    if (cmd === window.__deskFail) throw new Error('Unable to save right now');\n    if (cmd === 'current_plan') {\n      if (deskCurrent !== undefined) return deskCurrent;\n      if (new URLSearchParams(location.search).has('noPlan')) return null;\n      const pair = await deskOriginal(cmd, args);\n      deskCurrent = [pair[0], pair[1].map(workout => ({...workout, plannedDate:workout.date, status:'planned', movedAt:null}))];\n      return deskCurrent;\n    }\n    if (cmd === 'get_settings') return deskSettings ?? {...await deskOriginal(cmd, args), theme:new URLSearchParams(location.search).get('theme') ?? 'light', palette:new URLSearchParams(location.search).get('palette') ?? 'reference',llmEnabled:true,llmEndpoint:'https://example.test/v1',llmModel:'test-model'};\n    if (cmd === 'save_settings') { deskSettings = args.settings; return null; }\n    if (cmd === 'provider_status') return [{provider:'coros',connected:deskConnected,lastSync:new Date().toISOString(),detail:'Synthetic account'}];\n    if (cmd === 'coros_signin_notice') return null;\n    if (cmd === 'disconnect_provider') { deskConnected=false; return null; }\n    if (cmd === 'connect_provider') { deskConnected=true; return 'connected'; }\n    if (cmd === 'check_provider_api') return ['synthetic-list-activities'];\n    if (cmd === 'plan_defaults') return {currentWeeklyKm:32, thresholdSecKm:280, predict5kS:1200, predict10kS:2500, predictHalfS:5400, predictMarathonS:11400, thisWeekKm:12,totalKm:300,weeksObserved:4,lastSync:new Date().toISOString(),activePain:null};\n    if (cmd === 'create_plan') {\n      deskCurrent = [{id:'synthetic-plan',...args.request,status:'active',createdAt:new Date().toISOString(),pushedId:null,baselineWeeklyKm:args.request.currentWeeklyKm,qualityOffsetSecKm:0,qualityOffsetFrom:null},[]];\n      return deskCurrent;\n    }\n    if (cmd === 'run_scores') { const done = await deskMatched(); return done.map((workout, index) => ({ activityId: index + 1, workoutId: workout.id, load: 120 + index * 15, risk: 40 + index, riskDelta: index % 2 ? 1.4 : -0.8 })).concat([{ activityId: 4, workoutId: null, load: 96, risk: 38, riskDelta: -1.2 }]); }\n    if (cmd === 'matched_sessions') { const done = await deskMatched(); return done.map((workout, index) => ({ activityId: index + 1, title: workout.title, purpose: 'Build endurance at conversational pace so the body adapts without accumulating fatigue.', notes: 'Made with Runalytics - a virtual personal vibecoded coach \\n\\n' + workout.title + '\\n\\nPlan:\\n  2 km easy\\n\\nWhy: Build endurance at conversational pace.' })); }\n    if (cmd === 'calendar_events') {\n      const pair = await window.__TAURI_INTERNALS__.invoke('current_plan');\n      const events = (pair?.[1] ?? []).filter(workout => workout.date >= args.from && workout.date <= args.to).map(workout => ({...workout,workoutId:workout.id,activityId:workout.activityId ?? (workout.done ? 1 : null),notes:'Warm-up\\n2 km easy\\n\\nRepeat 4 times:\\n  1 km at 4:40/km\\n  60 seconds walking rest\\n\\nCool-down\\n1 km easy',adjusted:null,moved:workout.date!==workout.plannedDate,missed:false,start:workout.date,end:workout.date,allDay:true}));\n      if (new URLSearchParams(location.search).has('unmatched')) events.push({id:'unmatched',workoutId:null,activityId:99,date:args.from,kind:'completed',title:'Recorded run',distanceM:6000,durationMin:30,notes:'',adjusted:null,moved:false,missed:false,start:args.from,end:args.from,allDay:false});\n      return events;\n    }\n    if (cmd === 'move_workout') { deskCurrent[1].find(workout => workout.id === args.workoutId).date = args.date; return null; }\n    if (cmd === 'schedule_benchmark') {\n      const existing = deskCurrent[1].find(workout => workout.date === args.date);\n      const benchmark = {...existing,id:existing?.id ?? 'synthetic-benchmark',planId:deskCurrent[0].id,date:args.date,plannedDate:existing?.plannedDate ?? args.date,kind:'race',title:'Benchmark: '+args.name,distanceM:args.distanceM,done:false,status:'planned'};\n      deskCurrent[1] = deskCurrent[1].filter(workout => workout.id !== benchmark.id).concat(benchmark);\n      return null;\n    }\n    if (cmd === 'set_workout_skipped') { deskCurrent[1].find(workout => workout.id === args.workoutId).status = args.skipped ? 'skipped' : 'planned'; return null; }\n    if (cmd === 'abort_plan') { deskCurrent = null; return null; }\n    if (cmd === 'push_plan_to_provider') { if (window.__deskHoldPush) await new Promise(resolve => { window.__deskResolvePush=resolve; }); deskCurrent[0].pushedId = 'watch-plan'; return 'published'; }\n    if (cmd === 'match_calendar_activity') { const workout=deskCurrent[1].find(workout=>workout.id===args.workoutId);workout.activityId=args.activityId;workout.done=true;return null; }\n    if (cmd === 'week_deviations') return (deskCurrent?.[1] ?? []).filter(workout=>workout.date!==workout.plannedDate).map(workout=>({workoutId:workout.id,title:workout.title,from:workout.date,to:workout.plannedDate,restorable:true}));\n    if (cmd === 'plan_week_progress') { const weeks = new Map(); for (const workout of deskCurrent?.[1] ?? []) { const monday = new Date(workout.date + 'T12:00:00'); monday.setDate(monday.getDate() - ((monday.getDay() + 6) % 7)); const key = monday.getFullYear() + '-' + String(monday.getMonth()+1).padStart(2,'0') + '-' + String(monday.getDate()).padStart(2,'0'); const entry = weeks.get(key) ?? {weekStart:key,plannedM:0,ranM:0}; entry.plannedM += workout.distanceM ?? 0; if (workout.done) entry.ranM += workout.distanceM ?? 0; weeks.set(key, entry); } return [...weeks.values()].sort((a,b)=>a.weekStart.localeCompare(b.weekStart)); }\n    if (cmd === 'reset_week') { deskCurrent[1].forEach(workout=>{workout.date=workout.plannedDate;});return null; }\n    if (cmd === 'plan_sync_status') return deskSync;\n    if (cmd === 'plan_sync_configure') { deskSync.config.enabled = args.config.enabled; if (args.token) deskSync.config.hasToken=true; return deskSync; }\n    if (cmd === 'plan_sync_check') return {status:'upToDate',planName:'Synthetic plan',workouts:33,syncedAt:Math.floor(Date.now()/1000)};\n    if (cmd === 'plan_sync_push') return deskSync.config;\n    if (cmd === 'plan_sync_pull') return {installed:!!args.force,planName:'Synthetic plan',workouts:33,conflict:new URLSearchParams(location.search).has('syncConflict') && !args.force ? 'Different synthetic plan on this device.' : null};\n    if (cmd === 'calendar_publishing') return deskPublishing;\n    if (cmd === 'save_calendar_publishing') { deskPublishing={...deskPublishing,...args.config,hasPassword:args.password===null ? deskPublishing.hasPassword : args.password!==''}; return deskPublishing; }\n    if (cmd === 'ics_path') return '/synthetic/calendar.ics';\n    if (cmd === 'publish_calendar') { deskPublishing.lastPublished=new Date().toISOString(); return 'https://example.test/training.ics'; }\n    if (cmd === 'llm_status') { const settings=await window.__TAURI_INTERNALS__.invoke('get_settings'); return {configured:settings.llmEnabled,hasKey:deskKey,endpoint:settings.llmEndpoint,model:settings.llmModel}; }\n    if (cmd === 'clear_llm_api_key') { deskKey=false; return null; }\n    if (cmd === 'set_llm_api_key') { deskKey=true; return null; }\n    if (cmd === 'pain_entries') return deskPain;\n    if (cmd === 'save_pain_entry') { const entry={id:'synthetic-pain',bodyPart:args.bodyPart,intensity:args.intensity,startedOn:args.startedOn,notes:args.notes,createdAt:new Date().toISOString(),resolvedOn:null,followupAt:null};deskPain.push(entry);return [entry,null]; }\n    if (cmd === 'resolve_pain') { deskPain.find(entry=>entry.id===args.id).resolvedOn=args.resolvedOn; return null; }\n    if (cmd === 'mark_pain_followup') { deskPain.find(entry=>entry.id===args.id).followupAt=new Date().toISOString(); return null; }\n    if (cmd === 'delete_pain_entry') { deskPain=deskPain.filter(entry=>entry.id!==args.id);return null; }\n    if (cmd === 'pain_messages') return deskMessages;\n    if (cmd === 'clear_pain_messages') { deskMessages=[];return null; }\n    if (cmd === 'ask_assistant') { const answer={id:'reply',entryId:args.entryId,bodyPart:'knee.left',role:'assistant',content:'Consider reducing the session and discussing persistent pain with a clinician.',ts:new Date().toISOString()};deskMessages.push({id:'question',entryId:args.entryId,bodyPart:'knee.left',role:'user',content:args.question,ts:new Date().toISOString()},answer);return answer; }\n    if (cmd === 'pending_proposal') return proposal?.source==='pain' && proposal?.status==='pending' ? proposal : null;\n    if (cmd === 'pending_pacing_proposal') return proposal?.source==='pacing' && proposal?.status==='pending' ? proposal : null;\n    if (cmd === 'proposals') return proposal ? [proposal] : [];\n    if (cmd === 'apply_proposal') {\n      if(proposal.source==='pacing') {\n        const pair=await window.__TAURI_INTERNALS__.invoke('current_plan');\n        deskCurrent=[{...pair[0],qualityOffsetSecKm:proposal.planQualityOffsetSecKm,qualityOffsetFrom:proposal.planQualityOffsetFrom},pair[1]];\n      }\n      proposal.status='applied'; return null;\n    }\n    if (cmd === 'dismiss_proposal') { proposal.status='dismissed'; return null; }\n    if (['pain_days','pain_by_region'].includes(cmd)) return [];\n    if (cmd === 'pace_insights') {\n      if (new URLSearchParams(location.search).has('noPlan')) return null;\n      const day = offset => { const date=new Date();date.setDate(date.getDate()+offset);return date.toLocaleDateString('en-CA'); };\n      const rep = (index, actualSKm, bandLoSKm=275, bandHiSKm=285) => ({index,label:'Work rep',actualSKm,bandLoSKm,bandHiSKm,relativePace:((bandLoSKm+bandHiSKm)/2-actualSKm)/Math.max((bandHiSKm-bandLoSKm)/2,1)});\n      const session = (index, reps, kind='intervals') => ({workoutId:'insight-'+index,activityId:1,date:day(-30+index*5),title:kind==='tempo'?'Continuous tempo':kind==='longrun'?'Race-pace long run':'Interval session '+index,kind,outdated:index===0,reps});\n      return {speed:[session(0,[rep(2,268),rep(4,291)]),session(1,[rep(2,279),rep(4,281)]),session(2,[rep(2,280)],'tempo'),session(3,[rep(2,276),rep(4,300)]),session(4,[rep(2,265),rep(4,279)])],long:[session(1,[rep(2,322,315,325),rep(4,328,320,330)],'longrun')],nextSpeed:{id:'next-speed',date:day(3),title:'Tempo 5 km',distanceM:8000},nextLong:{id:'next-long',date:day(5),title:'Long run 13 km',distanceM:13000}};\n    }\n    if (['plan_receipt','pending_proposal','pending_pacing_proposal','pacing_report','session_review'].includes(cmd)) return null;\n    if (cmd === 'plugin:event|listen') { listeners.set(args.event,args.handler); return args.handler; }\n    if (cmd === 'plugin:event|unlisten') { listeners.delete(args.event); return null; }\n    return deskOriginal(cmd,args);\n  };\n})();"}}
