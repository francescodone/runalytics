inline: -4px; padding-inline: 4px; }\n  .review-tabs button { padding: 8px 11px; }\n  .training-context { align-items: flex-start; flex-wrap: wrap; gap: 16px; }\n  .training-context h2 { font-size: 26px; }\n  .desk-toolbar { gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }\n  .horizon-switch a { padding: 8px 12px; }\n  .date-controls { margin-left: auto; }\n  .schedule-workspace, .schedule-workspace.has-inspector { display: block; min-height: 0; }\n  .schedule-workspace.has-inspector .schedule-canvas { padding-right: 0; filter: none; }\n  .week-board { display: none; }\n  .mobile-date-ribbon { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; margin-bottom: 28px; }\n  .mobile-date-ribbon button { border: 0; border-radius: var(--desk-radius); padding: 10px 0; min-height: 80px; background: transparent; color: var(--desk-muted); display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 11px; }\n  .mobile-date-ribbon button strong { font-size: 20px; color: var(--desk-ink); }\n  .mobile-date-ribbon button[aria-pressed=\"true\"] { background: var(--desk-action); color: var(--desk-on-action); }\n  .mobile-date-ribbon button[aria-pressed=\"true\"] strong { color: inherit; }\n  .mobile-date-ribbon i { height: 4px; width: 4px; border-radius: 50%; }.mobile-date-ribbon .has-session { background: currentColor; }\n  .day-itinerary { display: block; min-height: 190px; }\n  .day-itinerary .session-tile { min-height: 145px; padding: 18px; gap: 12px; }\n  .day-itinerary .session-tile strong { font-size: 22px; }\n  .month-day { min-height: 48px; padding: 0; border-right: 0; }\n  .month-number { width: 100%; min-width: 0; position: relative; }\n  /* The full-width cell would stretch today's disc into a bar; keep it a circle. */\n  .month-number[aria-current=\"date\"] { width: 44px; }\n  .month-number i { display: block; position: absolute; bottom: 1px; right: 4px; font-size: 9px; font-style: normal; }\n  .month-sessions { display: none; }\n  .month-board { margin-bottom: 28px; }\n  .plan-studio { display: grid; }.plan-basis { padding: 20px; }\n  .roadmap-row { grid-template-columns: 90px minmax(20px, 1fr) 64px 64px; gap: 10px; font-size: 13px; }.roadmap-row > svg { display: none; }\n  .plan-composer { display: flex; flex-direction: column-reverse; gap: 24px; }.composer-summary { padding: 16px; }.composer-summary h3 { margin-bottom: 8px; }.composer-summary .definition-list { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-bottom: 0; }.composer-summary .definition-list > div { flex-direction: column; gap: 2px; border: 0; padding: 0; }.composer-summary dd { text-align: left; }.composer-summary p { display: none; }\n  .setup-band { padding: 20px; flex-direction: column; align-items: flex-start; gap: 16px; }\n  .desk-appbar { height: calc(64px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 16px 0; grid-template-columns: 1fr auto; gap: 8px; }\n  .desk-brand { font-size: 17px; }\n  .desk-brand img { width: 26px; height: 26px; }\n  .desk-navigation { position: fixed; bottom: calc(10px + env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: min(430px, calc(100% - 28px)); height: 64px; padding: 6px 10px; background: var(--desk-surface); border: 1px solid var(--desk-glass-border); border-radius: 999px; box-shadow: var(--desk-elevation), 0 10px 28px #0e1f1826; z-index: 10; gap: 6px; }\n  .desk-navigation a { flex: 1; flex-direction: column; gap: 3px; padding: 7px; font-size: 12px; border-radius: 999px; }\n  .desk-workspace { padding: 24px 16px calc(100px + env(safe-area-inset-bottom)); }\n  .connection-state { display: none; }\n  .workspace-heading { margin-bottom: 20px; }\n  .desk-notice { bottom: calc(92px + env(safe-area-inset-bottom)); flex-wrap: wrap; }\n  .desk-inspector { position: fixed; inset: 0; z-index: 15; overflow-y: auto; border: 0; padding: calc(16px + env(safe-area-inset-top)) 20px calc(28px + env(safe-area-inset-bottom)); }\n  .desk-dialog { max-height: calc(100dvh - 24px); }\n  .dialog-surface { padding: 20px; }\n  .form-grid { grid-template-columns: 1fr; gap: 16px; }\n  input, select, textarea { font-size: 16px; }\n}\n@media (max-width: 370px) { .desk-brand span { display: none; } }\n.desk-toolbar, .composer-summary, .setup-band { background: var(--desk-surface); }\n.desk-dialog, .route-controls { background: var(--desk-surface); border-color: var(--desk-glass-border); box-shadow: var(--desk-elevation); }\n.desk-notice { border: 1px solid color-mix(in srgb, var(--desk-canvas) 22%, transparent); box-shadow: var(--desk-elevation); }\n.desk-appbar { position: sticky; z-index: 11; }\n.desk-toolbar { padding: 10px 12px; border: 1px solid var(--desk-glass-border); border-radius: 16px; }\n.desk-dialog { border-radius: 22px; }\n.desk-inspector, .journal-workspace .desk-inspector { background: var(--desk-surface); border: 1px solid var(--desk-line); border-radius: 20px; padding: 24px; box-shadow: var(--desk-shadow); }\n.desk-navigation a[aria-current], .horizon-switch a[aria-current], .settings-task-list a:hover { background: color-mix(in srgb, var(--desk-selection) 80%, var(--desk-surface)); box-shadow: inset 0 1px 0 color-mix(in srgb, var(--desk-surface) 75%, transparent), 0 2px 8px color-mix(in srgb, var(--desk-action) 8%, transparent); }\n.session-tile { border-radius: 12px; box-shadow: inset 0 1px 0 color-mix(in srgb, var(--desk-surface) 55%, transparent); }\n.activity-row { border-radius: 10px; }\n.health-verdict { background: linear-gradient(115deg, color-mix(in srgb, var(--desk-action) 7%, transparent), transparent 80%); border-radius: 16px; padding-inline: 16px; }\n.race-estimates { margin-block: 24px; min-width: 0; }\n.race-estimates > p, .race-estimates details { font-size: 13px; color: var(--desk-muted); }\n.race-estimates table { table-layout: fixed; }\n.race-estimates th, .race-estimates td { overflow-wrap: anywhere; }\n.race-estimates tbody td:last-child { color: var(--desk-action); font-weight: 600; }