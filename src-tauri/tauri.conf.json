{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runalytics",
  "version": "0.15.0",
  "identifier": "com.fradone.runalytics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1499",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost pmtiles: https://tile.openstreetmap.org https://demotiles.maplibre.org; img-src 'self' data: blob: asset: http://asset.localhost pmtiles: https://tile.openstreetmap.org https://demotiles.maplibre.org; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; worker-src 'self' blob:; child-src blob:; frame-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$DOWNLOAD/**", "$DOCUMENT/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "category": "Sports",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0ODAwQjExQjUyOUVDQzAKUldUQTdDbTFFUXVBSk9QWXA4YUFxZ0FXdzJzWWVhVmlXUGxHZXowaHlEeDlTa2lPR2VGbDRpS2UK",
      "endpoints": [
        "https://github.com/francescodone/runalytics/releases/latest/download/latest.json"
      ]
    }
  }
}
