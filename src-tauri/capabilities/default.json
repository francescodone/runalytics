{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Runalytics window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "webcal://*" }] }
  ]
}
